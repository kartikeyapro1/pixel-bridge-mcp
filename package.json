{
  "name": "pixelbridge-mcp",
  "version": "0.3.0",
  "description": "MCP server and CLI that lets AI coding agents generate images and video with one Gemini API key and build 3D models in local Blender, with budgets, caching and an auditable asset registry.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "blender",
    "roblox",
    "asset-pipeline",
    "image-generation",
    "video-generation",
    "gemini",
    "ai-agents"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "bin": {
    "pixelbridge": "dist/cli.js",
    "pixelbridge-mcp": "dist/mcp-entry.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "blender/pixelbridge_bpy.py",
    "blender/README.md",
    "examples",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "prepublishOnly": "npm run check",
    "docs:tools": "npm run build && node scripts/gen-tool-docs.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kartikeyapro1/PixelBridge.git"
  },
  "homepage": "https://github.com/kartikeyapro1/PixelBridge#readme",
  "bugs": {
    "url": "https://github.com/kartikeyapro1/PixelBridge/issues"
  }
}
