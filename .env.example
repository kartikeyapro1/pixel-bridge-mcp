# Copy to .env (never commit it) or set these in your shell / MCP client config.
# PixelBridge reads credentials only from the environment and never logs them.

# The one key you need: images and video (Google Gemini API, from https://aistudio.google.com)
GEMINI_API_KEY=

# Optional: OpenAI as a second image provider (transparent backgrounds, masks)
OPENAI_API_KEY=

# Optional: explicit Blender executable (otherwise auto-detected)
BLENDER_PATH=

# Optional: project root PixelBridge operates in (defaults to the current directory)
PIXELBRIDGE_PROJECT_ROOT=
